AIAND_BASE_URL=https://your-provider.example.com/v1
AIAND_API_KEY=
AIAND_MODEL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Aura calls this the instance database; leave blank to use the default database.
NEO4J_DATABASE=
# Sent as reasoning_effort on every completion. low | medium | high (or whatever your provider accepts). "off" omits the parameter. Blank means low.
AIAND_REASONING_EFFORT=low
